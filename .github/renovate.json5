{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":disableRateLimiting",
    ":separateMajorReleases",
    ":semanticCommits",
    ":automergeMinor",
  ],
  ignorePaths: [
    "**/testdata/**",
  ],
  postUpdateOptions: [
    "gomodTidy",
    "gomodUpdateImportPaths",
  ],
  packageRules: [
    // The Envoy pin in envoybin/manifest.go holds SHA-256 hashes that belong
    // to the pinned version. Renovate cannot compute them, so the post-upgrade
    // command downloads every build of the new version and writes its hashes
    // into the manifest. The version and the hashes then land in one commit.
    // RENOVATE_ALLOWED_COMMANDS in .github/workflows/renovate.yaml permits the
    // command. The command fails when a build of the new version is missing,
    // which happens until Tetrate publishes the macOS build. The manifest
    // then keeps the hashes of the previous version, so the envoy workflow
    // fails on the pull request. Renovate runs the command again when it
    // rebases or retries the branch.
    //
    // The pin gets a branch of its own. The ci module pins the same
    // dependency, and without the prefix both updates share one branch.
    //
    // Renovate merges the bump itself, because platformAutomerge is false.
    // Renovate merges a pull request only after every check of the pull
    // request passed, so the merge waits for the envoy-pin check of the envoy
    // workflow. With platformAutomerge, GitHub merges the pull request when
    // the required status checks of the main branch pass. GitHub then does
    // not wait for a check that the branch does not require. Do not set
    // ignoreTests, because Renovate then merges without the checks.
    {
      matchFileNames: ["envoybin/manifest.go"],
      matchDepNames: ["envoyproxy/envoy"],
      additionalBranchPrefix: "envoybin-",
      commitMessageTopic: "pinned Envoy binary",
      platformAutomerge: false,
      postUpgradeTasks: {
        commands: ["go run ./cmd/envoymanifest update"],
        fileFilters: ["envoybin/manifest.go"],
        installTools: {
          golang: {},
        },
      },
    },
    // The Lima flake in lima/flake.nix holds the hash of the vendor tree of
    // the root Go module as vendorHash. Every change to a dependency in the
    // root go.mod changes the vendor tree, and the lint task fails when the
    // hash is stale. The post-upgrade command creates the vendor tree and
    // writes its hash into the flake, so the dependency and the hash land in
    // one commit. RENOVATE_ALLOWED_COMMANDS in .github/workflows/renovate.yaml
    // permits the command.
    {
      matchManagers: ["gomod"],
      matchFileNames: ["go.mod"],
      postUpgradeTasks: {
        commands: ["go run ./cmd/vendorhash update"],
        fileFilters: ["lima/flake.nix"],
        installTools: {
          golang: {},
        },
      },
    },
    // The Dagger modules in `ci` and `ci/tests` are outside the workspace of
    // go.work, and Dagger generates part of their packages. Renovate changes
    // a requirement in their go.mod and leaves go.sum with the hashes of the
    // previous version. The lint task fails when go.sum is stale. The
    // post-upgrade command runs `go mod download` in both modules and writes
    // the hashes of the new version into go.sum, so the requirement and the
    // hashes land in one commit. The go command raises another requirement
    // in go.mod when the new version needs a later version of it, so the
    // commit takes go.mod too. RENOVATE_ALLOWED_COMMANDS in
    // .github/workflows/renovate.yaml permits the command.
    {
      matchManagers: ["gomod"],
      matchFileNames: ["ci/go.mod", "ci/tests/go.mod"],
      postUpgradeTasks: {
        commands: ["go run ./cmd/modsum update"],
        fileFilters: ["ci/go.mod", "ci/go.sum", "ci/tests/go.mod", "ci/tests/go.sum"],
        installTools: {
          golang: {},
        },
      },
    },
    // The go.mod of the Dagger Go SDK replaces the OpenTelemetry log modules
    // with v0.16.0. The Dagger code generator writes those replace directives
    // into the go.mod of a Dagger module each time it generates the code of
    // the module, and the engine generates the code before it builds the
    // module. A version that Renovate writes into one of the directives has
    // no effect on the build, and the next `dagger develop` reverts it. This
    // rule stops Renovate from proposing a version for those modules. Remove
    // a module from the rule when the code generator stops writing its
    // replace directive.
    {
      matchManagers: ["gomod"],
      matchFileNames: ["ci/go.mod", "ci/tests/go.mod"],
      matchPackageNames: [
        "go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc",
        "go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploghttp",
        "go.opentelemetry.io/otel/log",
        "go.opentelemetry.io/otel/sdk/log",
      ],
      enabled: false,
    },
    // A Dagger module does not compile when it selects v1.47.0 or later of a
    // go.opentelemetry.io/otel module and v0.16.0 of otel/log.
    // otel/internal/global v1.47.0 imports otel/log, and otel/log v0.16.0
    // imports otel/internal/global. Each go.opentelemetry.io/otel module
    // requires the otel module of its own release, so an update of one of
    // them selects otel v1.47.0. This rule holds the modules at the versions
    // before v1.47.0. Remove the rule when the code generator replaces
    // otel/log with v1.47.0 or later, or stops replacing it.
    //
    // A glob matches a slash only with a path segment of two asterisks, so
    // the first pattern matches the otel module and the second pattern
    // matches the modules in its subdirectories.
    {
      matchManagers: ["gomod"],
      matchFileNames: ["ci/go.mod", "ci/tests/go.mod"],
      matchPackageNames: ["go.opentelemetry.io/otel", "go.opentelemetry.io/otel/**"],
      allowedVersions: "<1.47.0",
    },
  ],
  customManagers: [
    // Tool and image versions pinned as Go constants in the ci module,
    // annotated with `// renovate:` comments, e.g.:
    //   goreleaserVersion = "v2.13.3" // renovate: datasource=github-releases depName=goreleaser/goreleaser
    //   envoyVersion = "v1.37.1" // renovate: datasource=github-releases depName=envoyproxy/envoy
    // For image references, the version is the tag after the last colon.
    // The Envoy pin in envoybin/manifest.go carries the same annotation:
    //   const Version = "v1.40.2" // renovate: datasource=github-releases depName=envoyproxy/envoy
    {
      customType: "regex",
      managerFilePatterns: ["/^ci/.+\\.go$/", "/^envoybin/manifest\\.go$/"],
      matchStrings: [
        '"(?:[^"]*:)?(?<currentValue>[^":]+)"\\s*// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)',
      ],
      versioningTemplate: "{{#if (equals datasource 'docker')}}docker{{else}}semver-coerced{{/if}}",
    },
    // Tool versions pinned in Taskfiles as `<value> # renovate:` annotations,
    // e.g. the advisory deadcode pin:
    //   DEADCODE_VERSION: v0.46.0 # renovate: datasource=go depName=golang.org/x/tools
    // (devbox.json tool versions are handled by Renovate's built-in devbox
    // manager, so they need no customManager here.)
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)Taskfile\\.yaml$/", "/(^|/)\\.taskfiles/.+\\.yaml$/"],
      matchStrings: [
        '(?<currentValue>v?[0-9][^\\s#"]*)\\s*#\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)',
      ],
      versioningTemplate: "{{#if (equals datasource 'docker')}}docker{{else}}semver-coerced{{/if}}",
    },
  ],
}
